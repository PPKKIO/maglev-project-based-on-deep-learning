  $ Subsystems and standard elements (wheelsets, etc)
    with subs1; name="垂向传感器LF"; type=mbsincluded; 
      ro1x=; ro1y=; ro1z=; ro2x=; ro2y=; ro2z=; 
      ident=Subs1; 
    with main;
      type=mbs;  autogravity=true;  symbolic = false; size=1; scene=0; 
      objectidentifier=UMObject;
      bkgcolor=16777215; gridcolor=16448; axessaturation= 1.E2; 
      gridstep= 5.E-1; axelengthx= 3.; axelengthy= 3.; axelengthz= 3.; 
      rotationstyle = z;
      mousepick=false;
      sensitivity_threshold=0.050;
    with const;
      cnst=(ms# 0.01);
      cnst=(ps# ms*9.81);
      cnst=(beta# 0.3);
      cnst=(fs# 500);
      cnst=(k_sensor# sqr(2*pi*fs)*ms);
      cnst=(c_sensor# 2*beta*sqrt(k_sensor*ms));
      cnst=(dx_static# ps/k_sensor);
      cnst=(s_factor# k_sensor/ms);
      cnst=(r_sensor# 0.02);
      cnst=(h_sensor# 0.1);
      cnst=(p0# 0.0981# "Static deflection of spring");
    
    with var; name="xs"; expression=coordinate( "jMass", 1 , 0 );
    with var; name="a_sensor"; expression=-xs*s_factor;
    with egravity; gravityz=-1; 
    with go;
      name="Mass";
      p1x=; p1y=; p1z=; p2x=; p2y=; p2z=; angle1=0; angle2=0; angle3=0; 
      with ge; type=CYLINDER;
      VisibleSide=vsFront;  material=255,255,0,0,10,1;
      p1x=; p1y=; p1z=-r_sensor*0.9; p2x=; p2y=; p2z=; angle1=0; angle2=0; angle3=0; 
      width=1;
      Density=7800; SurfaceWidth=5; WireSection=5;
      h=r_sensor*0.9; r1=r_sensor*0.9; r2=r_sensor*0.9;
      npc=20; npl=2;
    with go;
      name="spring";
      p1x=; p1y=; p1z=; p2x=; p2y=; p2z=; angle1=0; angle2=0; angle3=0; 
      with ge; type=SPRING;
      VisibleSide=vsBoth;  material=65280,6520998,0,0,10,1;
      p1x=; p1y=; p1z=; p2x=; p2y=; p2z=; angle1=0; angle2=0; angle3=0; 
      width=2;
      SolidType=Wired; Density=7800; SurfaceWidth=5; WireSection=5;
      h=1; r=r_sensor*0.8; n=5; np=25;
    with go;
      name="Casing";
      p1x=; p1y=; p1z=; p2x=; p2y=; p2z=; angle1=0; angle2=0; angle3=0; 
      with ge; type=CYLINDER;
      VisibleSide=vsFront;  material=16711808,16711808,0,0,10,1;
      p1x=; p1y=; p1z=-h_sensor/2; p2x=; p2y=; p2z=; angle1=0; angle2=0; angle3=0; 
      wired=true;
      width=1;
      Density=7800; SurfaceWidth=5; WireSection=5;
      h=h_sensor; r1=r_sensor; r2=r_sensor;
      npc=20; npl=2;
    $ Bodies, inertia parameters, images
    with body1; name="Mass"; ppjoint=0; igrobj=1; 
      m=ms; ixx=0.00001; ixy=; ixz=; iyy=0.00001; iyz=; izz=0.00001; rcx=; rcy=; rcz=; 
        opoints={
          '' '' '' 'LSC'  '0' '0' '0' '0' '0' '0'
        };
    with body2; name="Sensor"; ppjoint=0; igrobj=3; 
      m=; ixx=; ixy=; ixz=; iyy=; iyz=; izz=; rcx=; rcy=; rcz=; 
        opoints={
          '' '' '' 'LSC'  '0' '0' '0' '0' '0' '0'
        };
      with jnt6dof; 
      position=1;
      p1x=; p1y=; p1z=; p2x=; p2y=; p2z=; 
      position=2;
      p1x=; p1y=; p1z=; p2x=; p2y=; p2z=; 
      position=0;
      angles=312; 
      x0=0; 
      y0=0; 
      z0=0; 
      angle10=0; 
      angle20=0; 
      angle30=0; 
    
    $ Joints, degrees of freedom, hinges, initial conditions
    with joint1; name="jMass"; type=transl; bd1="Sensor"; bd2="Mass"; 
      with jnt1dof; 
        ro1x=; ro1y=; ro1z=; ro2x=; ro2y=; ro2z=; 
      e1x=0; e1y=0; e1z= 1.; e2x=0; e2y=0; e2z= 1.; 
      constx=0; consta=0; x0=0; 
    with scalarforce; name="jMass"; type=none;
    
    $ Bipolar force elements
    with bfrc; name="Spring"; bd1="Mass"; bd2="Sensor"; igrobj=2; 
        ro1x=; ro1y=; ro1z=h_sensor/2; ro2x=; ro2y=; ro2z=; 
    with scalarforce; name="Spring"; type=linear;
      f0=p0; k=k_sensor; l0=h_sensor/2; d=c_sensor; q=0; w=0; a=0; 
    with end;
    
    with subs2; name="垂向传感器LR"; type=mbsincluded; 
      ro1x=; ro1y=; ro1z=; ro2x=; ro2y=; ro2z=; 
