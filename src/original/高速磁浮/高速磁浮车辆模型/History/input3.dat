  $ Subsystems and standard elements (wheelsets, etc)
    with subs1; name="垂向传感器LF"; type=mbsincluded; 
      ro1x=; ro1y=; ro1z=; ro2x=; ro2y=; ro2z=; 
      ident=Subs1; 
    with main;
      type=mbs;  autogravity=true;  symbolic = false; size=1; scene=0; 
      objectidentifier=UMObject;
      bkgcolor=16777215; gridcolor=16448; axessaturation= 1.E2; 
      gridstep= 5.E-1; axelengthx= 3.; axelengthy= 3.; axelengthz= 3.; 
      rotationstyle = z;
      mousepick=false;
      sensitivity_threshold=0.050;
    with const;
      cnst=(ms# 0.01);
      cnst=(ps# ms*9.81);
      cnst=(beta# 0.3);
      cnst=(fs# 500);
      cnst=(k_sensor# sqr(2*pi*fs)*ms);
      cnst=(c_sensor# 2*beta*sqrt(k_sensor*ms));
      cnst=(dx_static# ps/k_sensor);
      cnst=(s_factor# k_sensor/ms);
      cnst=(r_sensor# 0.02);
      cnst=(h_sensor# 0.1);
      cnst=(p0# 0.0981# "Static deflection of spring");
    
    with var; name="xs"; expression=coordinate( "jMass", 1 , 0 );
    with var; name="a_sensor"; expression=-xs*s_factor;
    with egravity; gravityz=-1; 
    with go;
      name="Mass";
      p1x=; p1y=; p1z=; p2x=; p2y=; p2z=; angle1=0; angle2=0; angle3=0; 
      with ge; type=CYLINDER;
      VisibleSide=vsFront;  material=255,255,0,0,10,1;
      p1x=; p1y=; p1z=-r_sensor*0.9; p2x=; p2y=; p2z=; angle1=0; angle2=0; angle3=0; 
      width=1;
      Density=7800; SurfaceWidth=5; WireSection=5;
      h=r_sensor*0.9; r1=r_sensor*0.9; r2=r_sensor*0.9;
      npc=20; npl=2;
